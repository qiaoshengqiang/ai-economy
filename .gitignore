# ============================================================
# AI Economy OS v0.1
# ============================================================

# --- 机密：绝对不要提交 ---
.env
*.key
secrets/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- 虚拟环境 ---
.venv/
venv/
env/

# --- 测试 / 缓存 ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Change Pipeline 的物理工作区（Git worktree）---
# Worktree 是**派生的**（可从 base_commit 重建），不是源码。
.worktrees/

# --- 运行时数据 ---
# 数据库是「运行产物」，不是源码。删掉可以用 seed 重新生成。
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
logs/*.log

# snake-demo 的 server pidfile 是**运行时产物**（含 pid），不是源码
data/snake-demo-server.json

# --- Agent 的私有记忆与工作产物 ---
# 注意：这里只忽略「生成出来的文件」，不忽略目录本身的 .gitkeep，
#       这样目录结构（也就是 Agent 的边界）依然保留在仓库里。
agents/*/memory/*
agents/*/workspace/*
!agents/*/memory/.gitkeep
!agents/*/workspace/.gitkeep

# --- macOS ---
.DS_Store
._*

# --- 编辑器 ---
.vscode/settings.json
.idea/
*.swp

# Decision Lab 的 HF 模型缓存（大文件，不进仓库）
decision-lab/.hf-cache/

# 真实 API 实验：库与快照可重建，不进仓库（结果 JSON 进）
experiments/real_api_self_evolution/data/
experiments/real_api_self_evolution/snapshot/

# Tool Runtime 的运行目录（每次工具执行的临时物化，不进仓库）
data/tool_runs/

# 公共工具库的二进制包（manifest 进仓库；node_modules / 浏览器缓存不进）
resources/public/tools/playwright/node_modules/
resources/public/tools/playwright-browsers/

# 观察实验的运行产物（数据库 / 日志 / 截图 / 工具物化，不进仓库）
experiments/agent_division/data/
experiments/agent_division/results/
experiments/agent_division/runs/
experiments/tool_collab/runs/
experiments/web_collab/runs/
experiments/user_demand/runs/

# Demand CLI runs (generated)
runs/demand/

# Pi Work 的真实 Task 目录（运行产物，不进仓库）
tasks/
