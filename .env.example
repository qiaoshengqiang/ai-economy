# ============================================================
# AI Economy OS v0.1 - 环境变量模板
# ------------------------------------------------------------
# 用法：
#   cp .env.example .env
#   然后把你自己的 Key 填进 .env
#
# 注意：.env 已经被 .gitignore 忽略，永远不会被提交。
#       绝对不要把真实 API Key 写进代码或 config.yaml。
#
# 现在可以全部留空！
# v0.1 阶段我们用 MockProvider，没有 Key 也能跑通整个经济系统。
# ============================================================

# ------------------------------------------------------------
# DeepSeek
# ------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------
# 豆包 Doubao（火山方舟 Volcengine Ark）
# 注意：豆包用的是「推理接入点 ID」而不是模型名，
#       endpoint 形如 ep-2024xxxxxx-xxxxx
# ------------------------------------------------------------
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=

# ------------------------------------------------------------
# Grok (xAI)
# ------------------------------------------------------------
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest

# ------------------------------------------------------------
# 系统级配置
# ------------------------------------------------------------
# 日志等级： DEBUG / INFO / WARNING / ERROR
AI_ECONOMY_LOG_LEVEL=INFO

# 数据库文件位置（相对项目根目录）
AI_ECONOMY_DB_PATH=data/economy.db
