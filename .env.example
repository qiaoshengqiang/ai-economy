# ============================================================
# AI Economy OS v0.1 - 环境变量模板
# ------------------------------------------------------------
# 用法：
#   cp .env.example .env
#   然后把你自己的 Key 填进 .env
#
# 注意：.env 已经被 .gitignore 忽略，永远不会被提交。
#       绝对不要把真实 API Key 写进代码或 config.yaml。
#
# 现在可以全部留空！
# v0.1 阶段我们用 MockProvider，没有 Key 也能跑通整个经济系统。
# ============================================================

# ------------------------------------------------------------
# DeepSeek（Step 2.5 起可以真实调用）
# ------------------------------------------------------------
# 怎么用：
#   1. 去 https://platform.deepseek.com 申请一个 API Key
#   2. 填在下面这一行（等号后面，不要加引号、不要留空格）
#   3. ./dev.sh ask "你好" --provider deepseek
#
# 不填也能用整个系统 —— 默认走 MockProvider，一个字都不用改。
# 这一行留空时，DeepSeek 会显示为「当前不可用」并说明原因。
DEEPSEEK_API_KEY=

# 下面两项一般不用改。它们可以覆盖 config/config.yaml 里的同名设置，
# 用途是临时指向代理或切换模型，而不用改配置文件。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------
# 豆包 Doubao（火山方舟 Volcengine Ark）
# ------------------------------------------------------------
# 注意：豆包和 DeepSeek 不一样 —— 它【没有固定模型名】，
#       所以 DOUBAO_MODEL 必须填，否则调不通。
#
# 两种写法，二选一：
#
#   ① 模型名称（推荐，直接用）
#      DOUBAO_MODEL=doubao-seed-1-6-250615
#      在火山方舟控制台的「模型广场」能看到当前可用的模型名。
#      日期后缀是版本号，新版本会换新日期。
#
#   ② 推理接入点 ID（较老的方式）
#      DOUBAO_MODEL=ep-2024xxxxxxxxx-xxxxx
#      需要先在控制台「在线推理」里创建接入点并部署，然后复制 ID。
#
# 【已知的坑】某些豆包模型会静默忽略 max_tokens：
#     传 max_tokens=16，实际输出 2586 tokens。
#   想控制输出长度，改 config/config.yaml 里这两项之一：
#     max_tokens_field: "max_completion_tokens"
#     extra_body: {thinking: {type: disabled}}
#   注意 max_tokens 和 max_completion_tokens 不能同时传，会 400。
#
# 不填也能用整个系统 —— 默认走 MockProvider。
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=

# ------------------------------------------------------------
# Grok (xAI)
# ------------------------------------------------------------
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest

# ------------------------------------------------------------
# 系统级配置
# ------------------------------------------------------------
# 日志等级： DEBUG / INFO / WARNING / ERROR
AI_ECONOMY_LOG_LEVEL=INFO

# 数据库文件位置（相对项目根目录）
AI_ECONOMY_DB_PATH=data/economy.db
